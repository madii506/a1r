{
  "functions": {
    "api/a1r.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/a1r?a=snap",
      "schedule": "17 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
